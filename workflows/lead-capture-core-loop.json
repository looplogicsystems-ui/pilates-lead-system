{
  "name": "Lead Capture & Booking — Core Loop",
  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body ?? $json;\nconst pick = (...keys) => { for (const k of keys) { const v = b[k]; if (v !== undefined && v !== null && v !== '') return v; } return undefined; };\nreturn { json: {\n  external_id: String(pick('external_id','from','Email or Instagram handle','email') ?? 'unknown'),\n  channel: String(pick('channel') ?? 'form'),\n  name: (pick('name','Name') ?? null),\n  message: String(pick('message','text','Your message') ?? ''),\n  studio_id: Number(pick('studio_id') ?? 1)\n} };"
      },
      "id": "normalize",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 304]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (external_id, channel, name, studio_id, status, created_at, updated_at)\nVALUES ($1, $2, $3, $4, 'engaged', now(), now())\nON CONFLICT (channel, external_id)\nDO UPDATE SET name = COALESCE(EXCLUDED.name, leads.name), updated_at = now()\nRETURNING id;",
        "options": { "queryReplacement": "={{ [$json.external_id, $json.channel, $json.name, $json.studio_id] }}" }
      },
      "id": "upsertLead",
      "name": "Upsert Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [448, 304],
      "retryOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (lead_id, direction, channel, body, created_at)\nVALUES ($1, 'inbound', $2, $3, now());",
        "options": { "queryReplacement": "={{ [$json.id, $('Normalize Lead').item.json.channel, $('Normalize Lead').item.json.message] }}" }
      },
      "id": "logInbound",
      "name": "Log Inbound Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [672, 304],
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Normalize Lead').item.json.message }}",
        "options": {
          "systemMessage": "You are the voice of {{STUDIO_NAME}}, a boutique {{STUDIO_TYPE}} studio in {{LOCATION}}. You reply to inbound leads as if you ARE the owner — warm, casual, human.\n\nStudio facts you may use:\n- Intro offer: {{OFFER e.g. 2-week unlimited pass for $35}}\n- Class schedule / open slots: {{SCHEDULE}}\n\nRules:\n- Sound like a real person texting. NEVER a template. No 'Hi [NAME], thanks for your interest!'.\n- Keep it short. No walls of text. Ask exactly ONE question that moves toward booking a class.\n- Use the conversation history to adapt to what the lead says.\n- If the lead accepts a specific class date/time, treat it as a booking.\n- ESCALATE (do not attempt to answer) if the lead asks a medical question or tries to negotiate price.\n\nYou MUST respond with ONLY a JSON object — no prose, no code fences:\n{\n  \"reply\": \"<message to send the lead>\",\n  \"intent\": \"continue\" | \"booking\" | \"escalate\",\n  \"booking\": { \"class_type\": \"...\", \"start_time\": \"YYYY-MM-DDTHH:MM:SS\", \"end_time\": \"YYYY-MM-DDTHH:MM:SS\" } | null,\n  \"escalate\": { \"reason\": \"...\" } | null\n}\nSet intent to 'booking' ONLY when a specific date/time is agreed, and include the booking object. Output booking start_time/end_time as the studio's LOCAL wall-clock time in the format YYYY-MM-DDTHH:MM:SS with NO 'Z' and NO timezone offset. Set intent to 'escalate' for medical/pricing-negotiation, include escalate.reason, and put a brief friendly holding message in reply. Otherwise intent is 'continue' with booking and escalate set to null."
        }
      },
      "id": "agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [912, 304]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": { "__rl": true, "value": "CALENDAR_EMAIL", "mode": "list", "cachedResultName": "CALENDAR_EMAIL" },
        "limit": 20,
        "options": {}
      },
      "id": "gcalTool",
      "name": "Google Calendar (read availability)",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [1120, 544]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.output ?? $json.text ?? '';\nlet data;\ntry {\n  const m = String(raw).match(/\\{[\\s\\S]*\\}/);\n  data = JSON.parse(m ? m[0] : raw);\n} catch (e) {\n  data = { reply: String(raw), intent: 'continue' };\n}\nconst ZONE = 'America/New_York'; // studio timezone — change per studio\nconst toZoned = (s) => {\n  try {\n    if (typeof s !== 'string' || !s) return s;\n    const naive = s.replace(/(?:Z|[+-]\\d{2}:?\\d{2})$/, '');\n    const dt = DateTime.fromISO(naive, { zone: ZONE });\n    return dt.isValid ? dt.toISO() : naive;\n  } catch (e) { return s; }\n};\nlet booking = data.booking ?? null;\nif (booking && typeof booking === 'object') {\n  booking = { ...booking, start_time: toZoned(booking.start_time), end_time: toZoned(booking.end_time) };\n}\nreturn { json: {\n  reply: data.reply ?? '',\n  intent: data.intent ?? 'continue',\n  booking: booking,\n  escalate: data.escalate ?? null\n} };"
      },
      "id": "parse",
      "name": "Parse Agent JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1184, 304]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (lead_id, direction, channel, body, created_at)\nVALUES ($1, 'outbound', $2, $3, now());",
        "options": { "queryReplacement": "={{ [$('Upsert Lead').first().json.id, $('Normalize Lead').first().json.channel, $('Parse Agent JSON').first().json.reply] }}" }
