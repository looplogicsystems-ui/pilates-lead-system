      ],
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "={{ $('Resolve Studio').first().json.gcal_booking_id }}",
          "mode": "id"
        },
        "start": "={{ $('Parse Agent JSON').first().json.booking.start_time }}",
        "end": "={{ $('Parse Agent JSON').first().json.booking.end_time }}",
