    {
      "id": "upsert-lead",
      "name": "Upsert Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        200,
        260
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Idempotent per (channel, external_id). The status CASE is the lifecycle:\n--   cold/new  -> engaged   (a returning lead re-enters the funnel; previously\n--                           a cold lead was stuck cold forever)\n--   escalated -> escalated (stays with the human until they resolve it)\n--   booked    -> booked    (already converted; must not re-enter nudging)\n-- and nothing moves at all while ai_paused is set.\nINSERT INTO leads (external_id, channel, name, studio_id, status, source_offer, created_at, updated_at)\nVALUES ($1, $2, $3, $4, 'engaged', $5, now(), now())\nON CONFLICT (channel, external_id) DO UPDATE SET\n    name         = COALESCE(EXCLUDED.name, leads.name),\n    source_offer = COALESCE(leads.source_offer, EXCLUDED.source_offer),\n    status       = CASE\n                     WHEN leads.ai_paused              THEN leads.status\n                     WHEN leads.status IN ('cold','new') THEN 'engaged'\n                     ELSE leads.status\n                   END,\n    updated_at   = now()\nRETURNING id, status, ai_paused;",
        "options": {
          "queryReplacement": "={{ [$('When Called').first().json.external_id, $('When Called').first().json.channel, $('When Called').first().json.name, $('Resolve Studio').first().json.studio_id, $('Resolve Studio').first().json.offers] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CRED_ID",
          "name": "Postgres account"
        }
      },
      "retryOnFail": true
    },
