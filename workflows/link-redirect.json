      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst code = String((j.query || {}).c || '');\nconst ua = String((j.headers || {})['user-agent'] || '');\nconst crawler = /facebookexternalhit|facebot|meta-externalagent|meta-externalfetcher|twitterbot|slackbot|linkedinbot|discordbot|telegrambot|whatsapp|googlebot|bingbot|applebot|crawler|spider|\\bbot\\b|preview/i.test(ua)\n  || ua === '';\nreturn [{ json: { code: /^[A-Za-z0-9_-]{4,16}$/.test(code) ? code : '', crawler } }];"
      }
    },
    {
      "id": "look-up-and-count",
      "name": "Look Up & Count",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Always exactly one row: target_url is NULL for an unknown code.\nWITH hit AS (\n  UPDATE booking_links\n     SET click_count = click_count + 1,\n         clicked_at  = COALESCE(clicked_at, now())\n   WHERE short_code = $1 AND NOT $2::boolean\n  RETURNING target_url\n)\nSELECT COALESCE((SELECT target_url FROM hit),\n                (SELECT target_url FROM booking_links WHERE short_code = $1)) AS target_url;",
        "options": {
          "queryReplacement": "={{ [$json.code, $json.crawler] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CRED_ID",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
