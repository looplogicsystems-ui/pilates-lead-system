# Secrets / credentials — never commit
.env
*.env
secrets/
credentials*.json

# Generated workflow JSON carrying real credential ids, staged for import.
# deploy.sh writes here; never commit it (the redacted copies in workflows/ are
# the committed ones).
.deploy-tmp/

# Deployment-specific IDs (calendar / Slack channel / IG account).
# Not secrets, but specific to one environment — see local-ids.sql.example
db/seed/local-ids.sql

# Windows "downloaded from the internet" marker files
*:Zone.Identifier

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Node (if any tooling is added later)
node_modules/
__pycache__/

# Real studios' details never go in this public repo (pilot build §K5).
# The committed template is db/seed/studios/_template.sql.example.
db/seed/studios/*.sql
