#!/usr/bin/env bash
# Put NEW Meta app secrets into the mini's .env and restart n8n with them.
#
# Run it in YOUR OWN terminal, right after pressing "Reset" in the Meta
# dashboard, never inside an agent session. The secrets are read hidden and
# sent over SSH stdin, so they never appear on screen, in shell history, in a
# process list or in a chat transcript.
#
#   bin/rotate-ig-secrets
#
# - IG_APP_SECRET            App settings > Basic > App secret
# - IG_APP_SECRET_INSTAGRAM  Instagram > API setup with Instagram login > Instagram app secret
#
# Restarts n8n once (~30 s). The Instagram adapter accepts a webhook signed
# with either secret, and Instagram's connect flow uses the Instagram one.
#
# ROTATE_DRY_RUN=1 rewrites a throwaway copy of .env instead (no restart) and
# reports what would change, to test the script itself.
set -euo pipefail
MINI="${MINI_HOST:-mac-server@100.64.98.51}"

echo "Paste each NEW secret from the Meta dashboard. Input is hidden. Enter alone = leave that one unchanged."
read -rsp "  IG_APP_SECRET (App settings > Basic): " A; echo
read -rsp "  IG_APP_SECRET_INSTAGRAM (Instagram app secret): " B; echo
A="$(printf '%s' "$A" | tr -d '[:space:]')"; B="$(printf '%s' "$B" | tr -d '[:space:]')"
[ -n "$A$B" ] || { echo "nothing entered, nothing changed"; exit 0; }
for v in "$A" "$B"; do
    if [ -n "$v" ] && ! [[ "$v" =~ ^[0-9a-f]{32}$ ]]; then
        read -rp "  One value isn't 32 lowercase hex characters, which Meta's secrets are. Continue anyway? [y/N] " ok
        [[ "$ok" =~ ^[Yy] ]] || { echo "nothing changed"; exit 1; }
    fi
done

# Remote side: reads the two values from stdin, rewrites only those two lines,
# restarts n8n through compose, then checks the running container has them.
REMOTE='
set -euo pipefail
cd ~/looplogic
if [ "$DRY" = 1 ]; then d="$(mktemp -d)"; trap "rm -rf $d" EXIT; cp -p .env "$d/.env"; cd "$d"; fi
IFS= read -r A || true; IFS= read -r B || true
for k in IG_APP_SECRET IG_APP_SECRET_INSTAGRAM; do
  [ "$(grep -c "^$k=" .env)" = 1 ] || { echo "!! $k is not exactly once in .env - nothing changed"; exit 1; }
done
umask 077
bak=".env.bak-$(date -u +%Y%m%dT%H%M%SZ)"; cp -p .env "$bak"
tmp="$(mktemp .env.new.XXXXXX)"
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    IG_APP_SECRET=*)           [ -n "$A" ] && line="IG_APP_SECRET=$A" ;;
    IG_APP_SECRET_INSTAGRAM=*) [ -n "$B" ] && line="IG_APP_SECRET_INSTAGRAM=$B" ;;
  esac
  printf "%s\n" "$line"
done < .env > "$tmp"
[ "$(wc -l < "$tmp")" -ge "$(grep -c "" "$bak")" ] || { rm -f "$tmp"; echo "!! rewrite lost lines - nothing changed"; exit 1; }
chmod 600 "$tmp"
if [ "$DRY" = 1 ]; then
  echo "DRY RUN on a copy: lines changed = $(diff "$bak" "$tmp" | grep -c "^>"), lines = $(wc -l < "$tmp"), mode $(stat -c %a "$tmp")"
  diff <(cut -d= -f1 "$bak") <(cut -d= -f1 "$tmp") >/dev/null && echo "  same keys, same order"
  exit 0
fi
mv "$tmp" .env
echo "==> .env updated; restarting n8n (about 30 s)"
docker compose up -d n8n >/dev/null 2>&1
for i in $(seq 1 40); do
  [ "$(curl -s -o /dev/null -w "%{http_code}" -m 5 http://localhost:5678/healthz/readiness)" = 200 ] && { echo "    n8n ready after ~$((i*3)) s"; break; }
  sleep 3
done
ok=1
chk () { # name, new value: compare hashes, never print values
  [ -z "$2" ] && { echo "    $1: unchanged"; return; }
  if [ "$(docker exec n8n printenv "$1" | tr -d "\n" | sha256sum)" = "$(printf "%s" "$2" | sha256sum)" ]; then
    echo "    $1: updated, and n8n is using it"
  else echo "!! $1: n8n is NOT using the new value"; ok=0; fi
}
chk IG_APP_SECRET "$A"; chk IG_APP_SECRET_INSTAGRAM "$B"
if [ "$ok" = 1 ]; then rm -f "$bak"; echo "==> done. Now DM the test bot from a personal account: an answer proves it."
else echo "!! previous .env kept at ~/looplogic/$bak"; exit 1; fi
'
printf '%s\n%s\n' "$A" "$B" | ssh -o BatchMode=yes "$MINI" "DRY=${ROTATE_DRY_RUN:-0}; $REMOTE"
