#!/usr/bin/env bash
# Copy ONE secret from the mini's .env to your clipboard, to paste into
# Bitwarden, without it ever being shown. Then press Enter and the clipboard
# is cleared.
#
# Run it in YOUR OWN terminal (WSL or macOS), never inside an agent session.
#
#   bin/copy-mini-secret IG_TOKEN_KEY
#   bin/copy-mini-secret OWNER_LINK_SECRET
set -euo pipefail
MINI="${MINI_HOST:-mac-server@100.64.98.51}"
name="${1:-}"
case "$name" in
  IG_TOKEN_KEY|OWNER_LINK_SECRET|IG_APP_SECRET|IG_APP_SECRET_INSTAGRAM|N8N_ENCRYPTION_KEY|N8N_USER_MANAGEMENT_JWT_SECRET|POSTGRES_PASSWORD) ;;
  *) echo "usage: $0 IG_TOKEN_KEY | OWNER_LINK_SECRET | IG_APP_SECRET | IG_APP_SECRET_INSTAGRAM | N8N_ENCRYPTION_KEY | ..."; exit 1 ;;
esac
if command -v clip.exe >/dev/null 2>&1; then copy=(clip.exe)
elif command -v pbcopy >/dev/null 2>&1; then copy=(pbcopy)
else echo "no clipboard tool (clip.exe or pbcopy)"; exit 1; fi

val_len="$(ssh -n -o BatchMode=yes "$MINI" "grep -m1 '^$name=' ~/looplogic/.env | cut -d= -f2- | tr -d '\r\n' | wc -c")"
[ "$val_len" -gt 0 ] || { echo "$name is empty or missing in the mini's .env"; exit 1; }
ssh -n -o BatchMode=yes "$MINI" "grep -m1 '^$name=' ~/looplogic/.env | cut -d= -f2- | tr -d '\r\n'" | "${copy[@]}"
echo "$name ($val_len characters) is on your clipboard."
echo "Paste it into Bitwarden: shared Loop Logic collection, item named \"$name (Mac mini .env)\"."
read -rp "Press Enter once it's saved, to clear the clipboard... " _
printf ' ' | "${copy[@]}"
echo "Clipboard cleared. (If Windows clipboard history (Win+V) is on, delete the entry there too.)"
